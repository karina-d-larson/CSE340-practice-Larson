<%- include('partials/header') %>

<main>
    <header class="course-header">
        <h1><%= course.title %></h1>
        <p class="course-id"><%= course.id %></p>
        <p class="course-department"><%= course.department %></p>
        <p class="course-credits"><%= course.credits %> credits</p>
        <p class="course-description"><%= course.description %></p>
    </header>

    <section class="sections">
        <div class="sections-header">
            <h2>Available Sections</h2>
            <nav class="sort-options" aria-label="Sort sections">
                <a href="/catalog/<%= course.id %>" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a>
                <a href="/catalog/<%= course.id %>?sort=professor" class="<%= currentSort === 'professor' ? 'active' : '' %>">Professor</a>
                <a href="/catalog/<%= course.id %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
            </nav>
        </div>
        <div class="section-list">
            <% course.sections.forEach((section) => { %>
            <article class="section-card">
                <p class="section-time"><%= section.time %></p>
                <p class="section-room"><%= section.room %></p>
                <p class="section-instructor"><%= section.professor %></p>
            </article>
            <% }) %>
        </div>
    </section>

    <section class="query-params">
        <h2>Query Parameters</h2>
        <% const queryEntries = Object.entries(queryParams || {}); %>
        <% if (queryEntries.length === 0) { %>
            <p>No query parameters were provided.</p>
        <% } else { %>
            <ul>
                <% queryEntries.forEach(([key, value]) => { %>
                    <li><%= key %>: <%= value %></li>
                <% }) %>
            </ul>
        <% } %>
    </section>

    <p class="back-link"><a href="/catalog">Back to Course Catalog</a></p>
</main>

<%- include('partials/footer') %>
